<Window
	x:Class="FaceRetouching.App.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:FaceRetouching.App"
	xmlns:controls="clr-namespace:FaceRetouching.App.Controls"
	xmlns:pages="clr-namespace:FaceRetouching.App.Pages"
	mc:Ignorable="d"
	WindowStartupLocation="CenterScreen"
	Title="Система ретуширования" Height="600" Width="1000">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition MinWidth="100" Width="2*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition MinWidth="100" Width="1*" />
		</Grid.ColumnDefinitions>

		<pages:SelectImagePage x:Name="selectImagePage" Grid.Column="0" />

		<GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" />

		<TabControl Grid.Column="2" Margin="10">
			<TabItem Header="Обработка">
				<pages:ImageModifyPage x:Name="imageModifyPage" />
			</TabItem>
			<TabItem Header="Плагины">
				<pages:LoadPlugins />
			</TabItem>
			<TabItem Header="Опубликовать плагин">
				<pages:UploadPlugins />
			</TabItem>
		</TabControl>

		<controls:ProgressBarControl x:Name="progressBarControl" Grid.ColumnSpan="3" />
	</Grid>
</Window>
