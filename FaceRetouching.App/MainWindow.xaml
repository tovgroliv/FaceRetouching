<Window
	x:Class="FaceRetouching.App.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:FaceRetouching.App"
	xmlns:controls="clr-namespace:FaceRetouching.App.Controls"
	mc:Ignorable="d"
	WindowStartupLocation="CenterScreen"
	Title="Система ретуширования" Height="600" Width="1000">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition MinWidth="100" Width="2*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition MinWidth="100" Width="1*" />
		</Grid.ColumnDefinitions>

		<controls:SelectImage x:Name="selectImage" Grid.Column="0" />
		<GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" />
		<Grid Grid.Column="2" IsEnabled="{Binding ElementName=selectImage, Path=Image, TargetNullValue=false}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Label Grid.Row="0" Margin="10" Content="Выберите плагины" />
			<ScrollViewer Grid.Row="1" Margin="10">
				<StackPanel x:Name="pluginsList" />
			</ScrollViewer>
			<Button Grid.Row="2" Margin="10" Content="Выполнить" Click="Button_Click" Height="30" />
		</Grid>
	</Grid>
</Window>
