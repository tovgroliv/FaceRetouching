<UserControl
	x:Class="FaceRetouching.App.Pages.SelectImagePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:FaceRetouching.App.Pages"
	mc:Ignorable="d" 
	d:DesignHeight="450" d:DesignWidth="800">

	<Grid>
		<Grid x:Name="selectPanel">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="50" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="10" AllowDrop="True" Drop="Border_Drop" Background="Transparent">
				<Rectangle
				Stroke="Black"
				RadiusX="10"
				RadiusY="10"
				StrokeThickness="1"
				StrokeDashArray="4 4"
				SnapsToDevicePixels="True" />
				<Label
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Content="Перетащите сюда изображение" />
			</Grid>

			<Button Grid.Row="1" Margin="10" Content="Выбрать файл" Click="Select_Click" />
		</Grid>

		<Grid x:Name="showPanel" Visibility="Collapsed">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="50" />
			</Grid.RowDefinitions>

			<Image Grid.Row="0" Margin="10" x:Name="image" />

			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Margin="10" Click="Save_Click" Content="Сохранить изображение" />
				<Button Grid.Column="1" Margin="10" Click="Cancel_Click" Content="Загрузить другое изображение" />
			</Grid>
		</Grid>
	</Grid>
</UserControl>
