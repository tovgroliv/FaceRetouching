<UserControl
	x:Class="FaceRetouching.App.Pages.UploadPluginsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:FaceRetouching.App.Pages"
	mc:Ignorable="d" 
	d:DesignHeight="450" d:DesignWidth="800">

	<StackPanel>
		<TextBlock TextWrapping="Wrap" FontSize="16" Margin="10" Text="Разработайте и опубликуйте свой собственный плагин" />
		<TextBlock TextWrapping="Wrap" Margin="10,5" Text="GUID (при обновлении плагина, для новых плагинов оставить пустым)" />
		<TextBox x:Name="pluginGuid" Margin="10,5" Height="20" />
		<TextBlock TextWrapping="Wrap" Margin="10,5" Text="Имя" />
		<TextBox x:Name="pluginName" Margin="10,5" Height="20" />
		<TextBlock TextWrapping="Wrap" Margin="10,5" Text="Описание" />
		<TextBox x:Name="pluginDescription" Margin="10,5" Height="20" />
		<TextBlock TextWrapping="Wrap" Margin="10,5" Text="Путь до файла" />
		<TextBox x:Name="pluginPath" IsEnabled="False" Margin="10,5" Height="20" />
		<Button Margin="10,5" Content="Выберите файлы плагина" Height="30" Click="SelectPlugin_Click" />
		<Button Margin="10,5" Content="Опубликовать" Height="30" Click="Upload_Click" />
	</StackPanel>
</UserControl>
