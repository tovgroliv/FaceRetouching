<UserControl
	x:Class="FaceRetouching.App.Pages.ImageModifyPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:FaceRetouching.App.Pages"
	mc:Ignorable="d" 
	d:DesignHeight="450" d:DesignWidth="800">

	<Grid IsEnabled="{Binding ElementName=selectImage, Path=Image, TargetNullValue=false}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Label Grid.Row="0" FontSize="16" Margin="10" Content="Выберите плагины" />
		<ScrollViewer Grid.Row="1" Margin="10">
			<StackPanel x:Name="pluginsList" />
		</ScrollViewer>
		<Button Grid.Row="2" Margin="10" Content="Выполнить" Click="Run_Click" Height="30" />
	</Grid>
</UserControl>
