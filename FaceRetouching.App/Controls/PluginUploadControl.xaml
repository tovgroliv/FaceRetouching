<UserControl
	x:Class="FaceRetouching.App.Controls.PluginUploadControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:FaceRetouching.App.Controls"
	mc:Ignorable="d"
	x:Name="base"
	d:DesignHeight="450" d:DesignWidth="800">

	<Border Background="#eeeeee" Padding="5" CornerRadius="5" Margin="5">
		<StackPanel>
			<TextBlock FontWeight="Bold" Text="Guid плагина:" />
			<TextBlock TextWrapping="Wrap" Text="{Binding ElementName=base, Path=PluginGuid}" />

			<TextBlock FontWeight="Bold" Text="Имя плагина:" />
			<TextBlock TextWrapping="Wrap" Text="{Binding ElementName=base, Path=PluginName}" />

			<TextBlock FontWeight="Bold" Text="Описание плагина:" />
			<TextBlock TextWrapping="Wrap" Text="{Binding ElementName=base, Path=PluginDescription}" />

			<TextBlock FontWeight="Bold" Text="Последнее обновление плагина:" />
			<TextBlock TextWrapping="Wrap" Text="{Binding ElementName=base, Path=PluginLastUpdate}" />

			<Button x:Name="load" Click="Load_Click" Content="Загрузить" Height="30" />
			<Button x:Name="remove" Click="Remove_Click" Content="Удалить" Height="30" />
		</StackPanel>
	</Border>
</UserControl>
